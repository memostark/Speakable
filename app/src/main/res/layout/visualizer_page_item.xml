<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools">
    <com.guillermonegrete.tts.customviews.NonScrollingTextView
        android:id="@+id/page_text_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingHorizontal="40dp"
        android:paddingTop="40dp"
        android:paddingBottom="@dimen/visualize_sheet_bar_height"
        android:textIsSelectable="true"
        android:lineSpacingExtra="@dimen/visualize_page_text_line_spacing_extra"
        android:textAppearance="?android:attr/textAppearanceLarge"
        tools:text="@string/large_text">
        <requestFocus />
    </com.guillermonegrete.tts.customviews.NonScrollingTextView>
</FrameLayout>

