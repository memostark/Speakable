<?xml version="1.0" encoding="utf-8"?>
<com.guillermonegrete.tts.common.views.NestedCoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:name="com.guillermonegrete.tts.importtext.tabs.WebLinksFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:clipToPadding="false"
        app:layoutManager="LinearLayoutManager"
        tools:context=".importtext.tabs.WebLinksFragment"
        tools:listitem="@layout/web_link_item" />

    <ProgressBar
        android:id="@+id/web_links_progress_bar"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="80dp"/>

    <TextView
        android:id="@+id/no_links_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_links_saved"
        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
        android:visibility="gone"
        android:layout_marginTop="80dp"
        android:layout_gravity="center_horizontal"
        tools:visibility="visible" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/add_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_margin="16dp"
        android:contentDescription="@string/add_new"
        app:layout_behavior=".common.views.NestedHideViewOnScrollBehavior"
        app:srcCompat="@drawable/ic_add_black_24dp"/>

</com.guillermonegrete.tts.common.views.NestedCoordinatorLayout>
